<?xml version="1.0" encoding="utf-8"?>
<!-- El visor de partituras carga sus archivos desde un servidor local de la
     propia app (solo 127.0.0.1); todo lo demás sigue exigiendo HTTPS. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
